{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "run_id", "code_version", "source_sha256", "evaluated_on", "data", "target", "cohort", "samples", "models", "metrics", "uncertainty", "assumptions", "limitations", "tables", "software"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "study_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "run_id": {"type": "string", "minLength": 8},
    "code_version": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "evaluated_on": {"type": "string"},
    "data": {"type": "object", "required": ["source_url", "release", "sha256", "license", "citation"], "properties": {"source_url": {"type": "string"}, "release": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "license": {"type": "string"}, "citation": {"type": "string"}}},
    "target": {"type": "object", "required": ["label", "estimand", "prediction_cutoff", "horizon", "unit"], "additionalProperties": {"type": "string"}},
    "cohort": {"type": "string", "minLength": 10},
    "samples": {"type": "object", "required": ["total", "test"], "additionalProperties": {"type": ["integer", "object"]}},
    "models": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "label", "specification"]}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "model", "estimate", "unit", "split"], "properties": {"estimate": {"type": "number"}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}, "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}}},
    "uncertainty": {"type": "string", "minLength": 10},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tables": {"type": "object"},
    "software": {"type": "object"}
  }
}
